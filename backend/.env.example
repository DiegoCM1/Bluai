# Backend config for local dev. Get the real values from Diego.
# DATABASE_URL must point at the STAGING branch — NEVER production. Full guide: docs/STAGING.md
DATABASE_URL="postgresql://user:password@host/database"
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@example.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
NOTIF_API_KEY="your-notifications-api-key"
OPENWEATHER_API_KEY="your-openweather-api-key"
LLM_API_KEY="your-llm-api-key"
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_MODEL="meta/muse-spark-1.3-contributor"
# Web search tool (optional). "basic" = 1 credit/search, "advanced" = 2 credits.
TAVILY_API_KEY="your-tavily-api-key"
TAVILY_SEARCH_DEPTH="basic"
DEV_BYPASS_MAP_EVENTS_AUTH="false"
# Dev-tools allowlist (test notifications, SIAT inject endpoints). Comma-separated;
# empty disables the endpoints for everyone. Matched OR — either list can grant access.
NOTIFICATION_TEST_ADMIN_EMAILS=""
NOTIFICATION_TEST_ADMIN_PHONES=""
# Payments — Stripe (leave empty to disable checkout; get keys from Stripe Dashboard)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_SAFE_MONTHLY="price_..."
STRIPE_PRICE_SAFE_ANNUAL="price_..."
STRIPE_PRICE_GUARD_MONTHLY="price_..."
STRIPE_PRICE_GUARD_ANNUAL="price_..."

# Real credentials above are for production only. Staging uses a Stripe sandbox.
STRIPE_MODE=live
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PRICE_SAFE_MONTHLY=
STRIPE_TEST_PRICE_SAFE_ANNUAL=
STRIPE_TEST_PRICE_GUARD_MONTHLY=
STRIPE_TEST_PRICE_GUARD_ANNUAL=
WEB_PAYMENTS_ENABLED=false
WEB_PAYMENTS_ORIGIN=https://www.bluai.com.mx
# In Railway staging set STRIPE_MODE=test and WEB_PAYMENTS_ORIGIN to the dev site.
