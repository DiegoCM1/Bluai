{
  "expo": {
    "name": "Bluai",
    "slug": "react-native-blueye",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/Icon.png",
    "userInterfaceStyle": "light",
    "scheme": "blueye",
    "newArchEnabled": true,
    "androidStatusBar": {
      "translucent": false,
      "barStyle": "light-content",
      "backgroundColor": "#3CCADC"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#0E7AFE"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#030810"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.bluai.app",
      "buildNumber": "18",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 15,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#DCF0FF"
      },
      "package": "com.bluai.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "BLUETOOTH_ADVERTISE",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "NEARBY_WIFI_DEVICES",
        "USE_FULL_SCREEN_INTENT",
        "SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ],
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "AIzaSyA7WPPSf4wIo-f52ESWanqP-Np72_tx9YE",
          "androidGoogleMapsApiKey": "AIzaSyB2swiDQepQYT1AjRlo_LiIoIh_JFWmhoU"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Bluai necesita acceso a tus contactos para que puedas agregar contactos SOS fácilmente."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bluai usa tu ubicación para enviarte alertas de huracán de tu zona y mostrarte los riesgos cerca de ti.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false
        }
      ],
      "./plugins/with-nearby-connections",
      "@react-native-firebase/app",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "bluai"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth",
              "RNFBMessaging"
            ]
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ed07ab1d-33c0-4d51-bec1-7d6c9d0e5fe9"
      }
    },
    "runtimeVersion": "2.0.0",
    "updates": {
      "url": "https://u.expo.dev/ed07ab1d-33c0-4d51-bec1-7d6c9d0e5fe9"
    },
    "owner": "diegodcm"
  }
}
